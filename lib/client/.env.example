# Copy to .env to run the client tests (`npm test`). They run against a live
# Qpon API, so point them at a disposable organization — the suites create,
# update and delete records.
#
# Without the four required variables below every suite is skipped.

QPON_BASE_URL=http://localhost:5000
QPON_API_KEY=
QPON_API_SECRET=
QPON_ORGANIZATION_ID=

# Optional. Ids of existing records to exercise the fetch/update/delete calls
# against. Each falls back to a placeholder UUID when unset.
QPON_COUPON_ID=
QPON_CAMPAIGN_ID=
QPON_COUPON_CODE_ID=
QPON_COUPON_CODE=
QPON_ITEM_ID=
QPON_ITEM_EXTERNAL_ID=
QPON_CUSTOMER_ID=
QPON_CUSTOMER_EMAIL=
QPON_CUSTOMER_EXTERNAL_ID=
QPON_USER_ID=
