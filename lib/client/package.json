{
  "name": "@org-quicko/qpon-client",
  "version": "3.0.2",
  "description": "Auto-generated type-safe client for Qpon APIs",
  "author": "Quicko <developer@quicko.org.in>",
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prebuild": "rm -rf dist && tsc --noEmit",
    "build": "rollup -c"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "license": "ISC",
  "files": [
    "dist/*"
  ],
  "directories": {
    "lib": "./dist"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^26.2.0",
    "glob": "^11.0.2",
    "rollup": "^4.41.1",
    "rollup-plugin-dts": "^6.2.1",
    "tslib": "^2.8.1",
    "typescript": "^5.6.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.9"
  }
}
