  "keyFeatures": [
    "Multi-organization support with role-based access control (super_admin, admin, editor, viewer, regular)",
    "Flexible discount types: percentage and fixed-amount",
    "Campaign management with optional budgets and status lifecycle (active, inactive, exhausted, archive)",
    "Coupon codes with visibility (public/private), duration (limited/forever), and customer constraints",
    "Real-time offer resolution — check applicable discounts for a customer and item pair",
    "Coupon code redemption with per-code and per-customer limits",
    "Analytics dashboards: day-wise, item-wise, and coupon-code-wise redemption summaries",
    "CSV export reports for redemptions, items, and customers",
    "Type-safe TypeScript client library (@org-quicko/qpon-client) with Zod validation",
    "API key authentication for server-to-server integrations",
    "Docker-based one-command deployment"
  ],
