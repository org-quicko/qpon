# Copy to .env.e2e (git-ignored). Real environment variables take precedence.
#
# Every value below has a built-in default that is used only when BASE_URL is
# localhost, i.e. a throwaway stack from `npm run stack:up`. Against any other
# host all of them must be set.

# Where the app is served. The Docker image serves the UI and API together.
BASE_URL=http://localhost:3000
# Only needed when the API is on a different origin, e.g. with `ng serve`:
# BASE_URL=http://localhost:4200
# API_URL=http://localhost:3000/api

# Created on a fresh database; must match the existing one otherwise.
SUPER_ADMIN_EMAIL=superadmin@qpon.test
SUPER_ADMIN_PASSWORD=

# Shared by the e2e-admin@, e2e-editor@ and e2e-viewer@ users.
E2E_MEMBER_EMAIL_DOMAIN=qpon.test
E2E_MEMBER_PASSWORD=
